# ============================================================
# Quant Platform - stock-service 生产环境变量模板
# 复制为 /opt/quant-platform/stock-service/quant-platform.env 后填入真实值
# 由 systemd 单元 EnvironmentFile 读取
# ============================================================

# ---- Spring ----
SPRING_PROFILES_ACTIVE=prod

# ---- MySQL (库名必须为 stock) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stock
MYSQL_USER=quant
MYSQL_PASSWORD=更换为强密码

# ---- ClickHouse (HTTP 8123, 库名 stock) ----
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=stock
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=更换为强密码

# ---- 前端跨域域名（逗号分隔，prod 必填） ----
CORS_ALLOWED_ORIGINS=https://your.domain.com

# ---- 凭证加密主密钥 (32 字节 = 64 位十六进制) ----
CREDENTIAL_AES_KEY=replace_with_64_hex_chars_random_key

# ---- Cookie 安全（HTTPS 环境设 true） ----
SA_TOKEN_COOKIE_SECURE=true

# ---- DeepSeek / LLM（启用 AI 分析时填） ----
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
